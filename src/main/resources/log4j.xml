<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%-5p] %c{1}:%L - %m%n" charset="UTF-8" />
        </Console>

        <RollingFile name="RollingFile"
                     fileName="/wmeter/icbm/userlog.log"
                     filePattern="/wmeter/icbm/userlog-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss.SSS}] %-5p %C{1}.%M(%F:%L) - %m%n" charset="UTF-8" />
            <Policies>
                <SizeBasedTriggeringPolicy size="5000 KB" />
            </Policies>
            <DefaultRolloverStrategy max="50" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="userlog" level="debug" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </Logger>

        <Logger name="com.istec.m1" level="debug" />
        
        <!-- MyBatis SQL 파라미터 로깅 -->
        <Logger name="mars.icbm" level="trace" />
        
        <!-- p6spy SQL 로깅 -->
        <Logger name="p6spy" level="info" />
        
        <Logger name="org.springframework.core" level="info" />
        <Logger name="org.springframework.beans" level="info" />
        <Logger name="org.springframework.context" level="info" />
        <Logger name="org.springframework.web" level="info" />

        <Root level="warn">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>