	    background: transparent;
	    text-align: right;
	    color: #41464d
	}
	
	div[name="pageContainer"] .form-control {
	    border-radius: 0px;
	    border: 0;
	    /* -webkit-box-shadow: none; */
	}
	
	#infoModal .modal-dialog {
	  width: 75%;
	  margin: 20px auto;
	}
	
	.main-content .navbar {
	    z-index: 100 !important;
	}


